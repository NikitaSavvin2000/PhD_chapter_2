digraph Update {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.45", ranksep="0.5", splines=ortho, fontname="Arial"];
  node [shape=box, style="rounded", color="#202020", penwidth=1.15, fontname="Arial", fontsize=12, margin="0.13,0.09"];
  edge [color="#303030", penwidth=1.0, arrowsize=0.7, fontname="Arial", fontsize=10];

  input [label="1. Новые наблюдения\nсчётчики, API, БД"];
  quality [label="2. Приём, контроль качества\nи подготовка временного ряда"];
  storage [label="3. Хранение подготовленных\nданных и конфигурации задачи"];
  airflow [label="4. Apache Airflow\nрасписание, зависимости, повторы", penwidth=1.6];
  condition [shape=diamond, style="", label="Условие\nобновления\nмодели?"];
  retrain [label="5а. Обновление /\nпереобучение модели"];
  predict [label="5б. Формирование\nнового прогноза"];
  result [label="6. Сохранение прогноза,\nметрик и версии результата"];
  backend [label="7. Передача через backend\nв прикладные сервисы"];
  ui [label="8а. Визуализация:\nфакт, прогноз, метрики"];
  alert [label="8б. Мониторинг порогов\nи уведомление пользователя"];
  agent [label="8в. ИИ-агент:\nобъяснение и запрос результата"];

  input -> quality -> storage -> airflow -> condition;
  condition -> retrain [label="да"];
  condition -> predict [label="нет"];
  retrain -> predict;
  predict -> result -> backend;
  backend -> ui;
  backend -> alert;
  backend -> agent;
  result -> storage [style=dashed, label="актуализация"];
  storage -> airflow [style=dashed, constraint=false, label="новые данные"];
}
