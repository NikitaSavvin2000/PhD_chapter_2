digraph Architecture {
  graph [rankdir=LR, bgcolor="white", pad="0.18", nodesep="0.42", ranksep="0.68", splines=ortho, fontname="Arial"];
  node [shape=box, style="rounded", color="#202020", penwidth=1.15, fontname="Arial", fontsize=12, margin="0.13,0.09"];
  edge [color="#303030", penwidth=1.0, arrowsize=0.7, fontname="Arial", fontsize=10];

  subgraph cluster_sources {
    label="Источники наблюдений"; color="#666666"; penwidth=1; style="rounded"; fontname="Arial"; fontsize=13;
    meters [label="Интеллектуальные счётчики\nи IoT-устройства"];
    api [label="Внешние API\nи промышленные системы"];
    history [label="Исторические БД\nи пользовательские файлы"];
  }

  subgraph cluster_data {
    label="Контур данных"; color="#666666"; penwidth=1; style="rounded"; fontname="Arial"; fontsize=13;
    ingest [label="Интеграционный сервис\nподключений и загрузки"];
    quality [label="Контроль качества,\nсинхронизация и подготовка"];
    storage [label="Хранилище временных рядов,\nконфигураций и прогнозов"];
  }

  subgraph cluster_compute {
    label="Вычислительный контур"; color="#666666"; penwidth=1; style="rounded"; fontname="Arial"; fontsize=13;
    airflow [label="Apache Airflow\nрасписание и зависимости задач", penwidth=1.6];
    features [label="Формирование признаков\nи временных представлений"];
    models [label="Сервисы прогнозирования\nи обновления моделей"];
    experiments [label="Конфигурации и\nвычислительные эксперименты"];
  }

  subgraph cluster_access {
    label="Прикладной контур"; color="#666666"; penwidth=1; style="rounded"; fontname="Arial"; fontsize=13;
    backend [label="Backend: API, метаданные,\nпубликация результатов"];
    ui [label="No-code интерфейс\nэнергетика и аналитика"];
    monitor [label="Мониторинг факта,\nпрогноза и метрик"];
    alerts [label="Уведомления\nэлектронная почта, мессенджеры"];
    agent [label="ИИ-агент\nчеловеко-читаемый запрос"];
  }

  meters -> ingest;
  api -> ingest;
  history -> ingest;
  ingest -> quality -> storage;
  storage -> features;
  airflow -> features [style=dashed, label="управление"];
  features -> models;
  experiments -> models;
  airflow -> models [style=dashed, label="запуск"];
  models -> storage [label="прогноз, версия, метрики"];
  storage -> backend;
  backend -> ui;
  backend -> monitor;
  monitor -> alerts;
  agent -> backend;
  ui -> backend [dir=both, label="параметры задачи"];
  backend -> airflow [style=dashed, label="конфигурация"];
}
